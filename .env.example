# PostgreSQL Configuration
POSTGRES_DB=amazon_v3
POSTGRES_USER=amazon_user
POSTGRES_PASSWORD=amazon_pass
POSTGRES_HOST=database-service
POSTGRES_PORT=5432

# Django Backend Configuration
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=v3-local-dev-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# Gateway / Proxy Configuration
PROXY_PORT=8080
