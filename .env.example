# =============================================================================
# Docker Compose environment variables
# =============================================================================
# Copy this file to ".env" and adjust the values for your environment.
# In production, use strong, randomly generated secrets.

# ---------------------------------------------------------------------------
# PostgreSQL database
# ---------------------------------------------------------------------------
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace-local-password

# ---------------------------------------------------------------------------
# Django backend
# ---------------------------------------------------------------------------
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=local-development-secret-change-before-production
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:3000,http://frontend-service

# CORS — the frontend is served by nginx and proxies /api/ to the backend,
# so CORS is not strictly needed in production. Set to "true" only if you
# need the frontend to call the API directly (e.g. during local dev).
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Database connection (used by the Django backend container)
# ---------------------------------------------------------------------------
POSTGRES_HOST=database-service
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Gunicorn tuning
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# ---------------------------------------------------------------------------
# Frontend → backend proxy (used by the nginx container)
# ---------------------------------------------------------------------------
BACKEND_HOST=backend-service
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Frontend build-time API URL (used by Vite at build time)
# The frontend nginx container reverse-proxies /api/ to the backend, so the
# built SPA uses a relative /api base URL. This is only needed for local dev
# (vite preview / dev server) where the proxy is not available.
# ---------------------------------------------------------------------------
VITE_API_URL=/api
